---
import Base from '../layouts/Base.astro';
import HeroSala from '../components/HeroSala.astro';
import Manifesto from '../components/Manifesto.astro';
import Collezione from '../components/Collezione.astro';
import Spazio from '../components/Spazio.astro';
import Titolare from '../components/Titolare.astro';
import Visita from '../components/Visita.astro';
import { negozio } from '../data/sito';
import { opere } from '../data/opere';

const ld = {
  '@context': 'https://schema.org',
  '@type': ['ArtGallery', 'Store'],
  name: negozio.nome,
  description: "Galleria d'arte e negozio a Cesano Boscone: quadri d'autore, classico moderno, pop art, grafiche, abbigliamento, oggettistica e idee regalo.",
  url: Astro.site?.href,
  image: new URL('/og.jpg', Astro.site).href,
  telephone: '+393501330118',
  email: negozio.email,
  vatID: 'IT' + negozio.piva,
  address: {
    '@type': 'PostalAddress',
    streetAddress: negozio.indirizzo.via,
    addressLocality: negozio.indirizzo.citta,
    addressRegion: negozio.indirizzo.provincia,
    addressCountry: 'IT',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'La collezione',
    itemListElement: opere.map((o) => ({ '@type': 'VisualArtwork', name: o.titolo, url: new URL(`/opere/${o.slug}`, Astro.site).href })),
  },
};
---
<Base
  title="Benny Store | Galleria d'arte a Cesano Boscone"
  description="Quadri d'autore, pop art, grafiche e classici in via delle Betulle 1/3 a Cesano Boscone. Guarda la collezione online o chiamaci: +39 350 133 0118."
  ingresso
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />
  <HeroSala />
  <Manifesto />
  <Collezione />
  <Spazio />
  <Titolare />
  <Visita />
</Base>
