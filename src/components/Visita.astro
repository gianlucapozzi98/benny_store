---
// VISITA — come arrivare e come chiedere di un'opera. Righe da elenco, mappa solo con consenso, FAQ vere.
import { negozio, mapsHref } from '../data/sito';
const ind = `${negozio.indirizzo.via}, ${negozio.indirizzo.citta} (${negozio.indirizzo.provincia})`;
const embed = 'https://www.google.com/maps?output=embed&q=' + encodeURIComponent('Via delle Betulle 1/3, Cesano Boscone MI');

// Solo domande con risposta certa. Orari, spedizioni, valutazioni: da chiedere al cliente.
const faq = [
  { d: 'Dove si trova la galleria?', r: `In ${ind}.` },
  { d: "Come chiedo il prezzo o l'artista di un'opera?", r: `Chiamaci al ${negozio.telefono.vista}, scrivi a ${negozio.email} oppure passa in galleria. Da ogni pagina d'opera puoi scriverci con il messaggio già pronto.` },
  { d: 'Cosa trovo oltre ai quadri?', r: "Quadri d'autore, classico moderno e pop art, e poi abbigliamento, oggettistica e idee regalo." },
];
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.d, acceptedAnswer: { '@type': 'Answer', text: f.r } })),
};
---
<section class="visita sezione" id="visita" aria-labelledby="visita-titolo">
  <header class="visita__testa">
    <p class="etichetta visita__eti" data-svela>Visita</p>
    <h2 id="visita-titolo" class="titolo-sezione" data-svela>Vieni a vederle<br />dal vivo.</h2>
  </header>

  <div class="visita__griglia">
    <dl class="righe" data-svela>
      <div class="riga-info">
        <dt class="etichetta">Indirizzo</dt>
        <dd>{negozio.indirizzo.via}, {negozio.indirizzo.citta} ({negozio.indirizzo.provincia})</dd>
        <dd class="riga-info__azione"><a class="sottolinea" href={mapsHref} target="_blank" rel="noopener">Indicazioni<span class="sr-only"> (Google Maps, nuova scheda)</span> <span aria-hidden="true">↗</span></a></dd>
      </div>
      <div class="riga-info">
        <dt class="etichetta">Telefono</dt>
        <dd>{negozio.telefono.vista}</dd>
        <dd class="riga-info__azione"><a class="sottolinea" href={negozio.telefono.href}>Chiama <span aria-hidden="true">→</span></a></dd>
      </div>
      <div class="riga-info">
        <dt class="etichetta">Email</dt>
        <dd class="riga-info__email">{negozio.email}</dd>
        <dd class="riga-info__azione"><a class="sottolinea" href={`mailto:${negozio.email}`}>Scrivi <span aria-hidden="true">→</span></a></dd>
      </div>
      <div class="riga-info">
        <dt class="etichetta">Orari</dt>
        <dd><span class="da-confermare">Orari da confermare</span></dd>
        <dd class="riga-info__azione riga-info__nota">Chiama prima di passare</dd>
      </div>
    </dl>

    <div class="mappa" data-mappa data-src={embed} data-svela>
      <div class="mappa__segnaposto" data-mappa-segnaposto>
        <p class="mappa__indirizzo">{negozio.indirizzo.via}<br /><em>{negozio.indirizzo.citta}</em></p>
        <p>La mappa è di Google Maps, che usa cookie di terze parti. La carichiamo solo se lo scegli tu.</p>
        <button type="button" class="btn btn--chiaro btn--piccolo" data-mappa-carica>Accetta e mostra la mappa</button>
        <button type="button" class="link mappa__pref" data-apri-preferenze>Preferenze cookie</button>
      </div>
    </div>
  </div>

  <div class="faq" data-svela>
    <h3 class="faq__titolo">Domande frequenti</h3>
    {faq.map((f) => (
      <details class="faq__voce">
        <summary>{f.d}</summary>
        <p>{f.r}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</section>

<style>
  .visita { max-width: calc(var(--max) + 2 * var(--gutter)); margin: 0 auto; }
  .visita__testa { display: grid; gap: 1.5rem; margin-bottom: clamp(3rem, 6vw, 5rem); }
  .visita__eti { color: var(--grafite); }

  .visita__griglia { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }

  .righe { margin: 0; border-top: 1px solid var(--inchiostro); }
  .riga-info {
    display: grid; grid-template-columns: 7.5rem 1fr auto; align-items: baseline; gap: 1rem;
    padding: 1.25rem 0; border-bottom: 1px solid var(--linea);
  }
  .riga-info dt { color: var(--grafite); }
  .riga-info dd { margin: 0; font-family: var(--serif); font-size: clamp(1.375rem, 1rem + 1.2vw, 2.25rem); line-height: 1.15; }
  .riga-info__email { overflow-wrap: anywhere; }
  .riga-info dd.riga-info__azione { font-family: var(--font); font-size: var(--fs-etichetta); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
  .riga-info__azione a { display: inline-block; padding: 0.75rem 0; }
  .riga-info__nota { color: var(--grafite); font-weight: 600 !important; }

  .mappa { position: relative; min-height: 26rem; overflow: hidden; background: var(--sala); color: var(--avorio); }
  .mappa :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .mappa__segnaposto {
    position: absolute; inset: 0; display: grid; align-content: end; justify-items: start; gap: 1rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background:
      radial-gradient(50% 40% at 70% 30%, rgba(229, 56, 63, 0.18), transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 46px, rgba(255, 255, 255, 0.05) 46px 47px),
      repeating-linear-gradient(90deg, transparent 0 46px, rgba(255, 255, 255, 0.05) 46px 47px),
      var(--sala);
  }
  .mappa__segnaposto p { max-width: 36ch; font-size: 0.9375rem; color: rgba(244, 242, 236, 0.8); }
  .mappa__segnaposto p.mappa__indirizzo { font-family: var(--serif); font-size: clamp(2rem, 1.4rem + 2vw, 3.25rem); line-height: 1; color: var(--avorio); }
  .mappa__pref { background: none; border: 0; padding: 0.5rem 0; cursor: pointer; font-size: 0.875rem; }

  .faq { margin-top: clamp(4rem, 8vw, 6rem); max-width: 52rem; }
  .faq__titolo { font-family: var(--serif); font-style: italic; font-weight: 400; font-size: var(--fs-h3); margin-bottom: 1rem; }
  .faq__voce { border-top: 1px solid var(--linea); }
  .faq__voce:last-child { border-bottom: 1px solid var(--linea); }
  .faq__voce summary {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    min-height: 3.5rem; padding: 0.75rem 0; cursor: pointer; list-style: none;
    font-weight: 600; font-size: 1.0625rem;
  }
  .faq__voce summary::-webkit-details-marker { display: none; }
  .faq__voce summary::after { content: '+'; font-size: 1.5rem; font-weight: 300; transition: transform var(--dur-rapida) var(--ease-out); }
  .faq__voce[open] summary::after { transform: rotate(45deg); }
  .faq__voce p { padding-bottom: 1.25rem; max-width: 64ch; color: var(--grafite); }

  @media (max-width: 960px) { .visita__griglia { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .riga-info { grid-template-columns: minmax(0, 1fr) auto; gap: 0.25rem 1rem; }
    .riga-info dt { grid-column: 1 / -1; }
  }
  /* Telefoni stretti (320–400 px): l'azione va a capo sotto il dato, così niente scorrimento orizzontale */
  @media (max-width: 400px) {
    .riga-info { grid-template-columns: minmax(0, 1fr); }
    .riga-info dd.riga-info__azione { white-space: normal; }
  }
</style>

<script>
  import { leggiConsenso, salvaConsenso, type Consenso } from '../scripts/consenso';
  const box = document.querySelector<HTMLElement>('[data-mappa]');
  if (box) {
    const carica = () => {
      if (box.querySelector('iframe')) return;
      const f = document.createElement('iframe');
      f.src = box.dataset.src!;
      f.title = 'Mappa: Benny Store, via delle Betulle 1/3, Cesano Boscone';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      box.append(f);
      box.querySelector<HTMLElement>('[data-mappa-segnaposto]')!.hidden = true;
    };
    const togli = () => {
      box.querySelector('iframe')?.remove();
      box.querySelector<HTMLElement>('[data-mappa-segnaposto]')!.hidden = false;
    };
    if (leggiConsenso()?.mappe) carica();
    document.addEventListener('consenso', (e) => ((e as CustomEvent<Consenso>).detail.mappe ? carica() : togli()));
    box.querySelector('[data-mappa-carica]')!.addEventListener('click', () => {
      const c = leggiConsenso();
      salvaConsenso({ mappe: true, statistiche: c?.statistiche ?? false });
      document.querySelector<HTMLElement>('[data-cookie]')?.setAttribute('hidden', '');
    });
  }
</script>
