---
// NEVE — fiocchi su un canvas, solo decorativi (aria-hidden).
// "fondo": fiocchi piccoli e lontani; "fronte": pochi fiocchi grandi e sfocati davanti a tutto.
// Il vento segue leggermente il puntatore. Si ferma quando non è sullo schermo o la scheda è nascosta;
// con "Riduci movimento" non c'è.
interface Props { quanti?: number; strato?: 'fondo' | 'fronte' }
const { quanti = 80, strato = 'fondo' } = Astro.props;
---
<canvas class={`neve neve--${strato}`} data-neve={quanti} data-strato={strato} aria-hidden="true"></canvas>

<style>
  .neve { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .neve--fondo { z-index: 1; opacity: 0.85; }
  .neve--fronte { z-index: 4; filter: blur(1.5px); }
  @media (prefers-reduced-motion: reduce) { .neve { display: none; } }
</style>

<script>
  import { riduci } from '../scripts/movimento';

  type Fiocco = { x: number; y: number; r: number; v: number; a: number; o: number };
  let vento = 0, ventoVoluto = 0;
  addEventListener('pointermove', (e) => { ventoVoluto = (e.clientX / innerWidth - 0.5) * 1.1; }, { passive: true });

  function avvia(c: HTMLCanvasElement) {
    const ctx = c.getContext('2d');
    if (!ctx) return;
    const fronte = c.dataset.strato === 'fronte';
    const n = Math.round(Number(c.dataset.neve) * (innerWidth < 700 ? 0.5 : 1));
    const dpr = Math.min(2, devicePixelRatio || 1);
    let w = 0, h = 0;
    const misura = () => {
      const r = c.getBoundingClientRect();
      w = r.width; h = r.height;
      c.width = Math.round(w * dpr); c.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const nuovo = (y?: number): Fiocco => ({
      x: Math.random() * w,
      y: y ?? Math.random() * h,
      r: fronte ? 2.5 + Math.random() * 3.5 : 0.7 + Math.random() * 2.1,
      v: fronte ? 0.9 + Math.random() * 1.1 : 0.25 + Math.random() * 0.75,
      a: Math.random() * Math.PI * 2,
      o: fronte ? 0.3 + Math.random() * 0.35 : 0.35 + Math.random() * 0.55,
    });
    misura();
    const fiocchi = Array.from({ length: n }, () => nuovo());

    let raf = 0, prima = 0;
    const passo = (t: number) => {
      const dt = prima ? Math.min(3, (t - prima) / 16.67) : 1;
      prima = t;
      vento += (ventoVoluto - vento) * 0.02;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = '#fff';
      for (const f of fiocchi) {
        f.a += 0.012 * dt;
        f.y += f.v * dt;
        f.x += (Math.sin(f.a) * 0.45 + vento * (fronte ? 1.4 : 1)) * dt;
        if (f.y - f.r > h) Object.assign(f, nuovo(-f.r));
        if (f.x > w + 8) f.x = -8; else if (f.x < -8) f.x = w + 8;
        ctx.globalAlpha = f.o;
        ctx.beginPath();
        ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2);
        ctx.fill();
      }
      raf = requestAnimationFrame(passo);
    };
    new IntersectionObserver(([e]) => {
      cancelAnimationFrame(raf);
      prima = 0;
      if (e.isIntersecting) raf = requestAnimationFrame(passo);
    }).observe(c);
    new ResizeObserver(misura).observe(c);
  }

  if (!riduci()) document.querySelectorAll<HTMLCanvasElement>('canvas[data-neve]').forEach(avvia);
</script>
