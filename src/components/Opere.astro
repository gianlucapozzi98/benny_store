---
// LE OPERE — bento: un'opera in evidenza + griglia a 2 colonne.
// Foto in bianco e nero che tornano a colori (hover, focus, tocco, faretto).
// Nessun titolo, autore, anno o prezzo: il cliente non li ha forniti.
import { Picture } from 'astro:assets';
import { mailto } from '../data/sito';
import ombrello from '../assets/foto/opera-stampa-ombrello-rosso.jpg';
import voltoRosa from '../assets/foto/opera-grafica-volto-rosa.jpg';
import sacra from '../assets/foto/opera-grafica-composizione-sacra.jpg';
import pannocchie from '../assets/foto/opera-grafica-pannocchie.jpg';
import ritrattoVerde from '../assets/foto/opera-pop-ritratto-verde.jpg';
import chitarrista from '../assets/foto/opera-disegno-chitarrista.jpg';
import matericaBlu from '../assets/foto/opera-materica-blu.jpg';

const evidenza = {
  img: ombrello,
  breve: 'la stampa con le due figure sotto l\'ombrello rosso',
  alt: 'Stampa con due figure abbracciate sotto un ombrello rosso, in una stanza con pavimento a scacchi',
};
const opere = [
  { img: voltoRosa, breve: 'la grafica con il volto geometrico rosa su fondo verde', alt: 'Grafica con un volto geometrico rosa su fondo verde, in cornice nera' },
  { img: ritrattoVerde, breve: 'il ritratto stencil in grigio e verde', alt: "Ritratto in stile stencil di un uomo che guarda verso l'alto, in grigio, nero e verde" },
  { img: sacra, breve: 'la grafica con la cupola, l\'angelo e i simboli sacri', alt: 'Grafica a colori con una cupola, un angelo e simboli sacri, in cornice argento' },
  { img: chitarrista, breve: 'il disegno del chitarrista in cornice dorata', alt: "Disegno a inchiostro e colori di un uomo che suona la chitarra, in cornice dorata" },
  { img: pannocchie, breve: 'la grafica con le pannocchie gialle', alt: 'Grafica con pannocchie gialle su fondo scuro, in cornice bianca' },
  { img: matericaBlu, breve: "l'opera materica con i cerchi blu", alt: 'Opera materica su tela grezza con due cerchi blu e viola, in cornice bianca a cassetta' },
];
const chiedi = (breve: string) =>
  mailto('Informazioni su un\'opera vista sul sito', `Ciao Benny Store,\nvorrei qualche informazione su ${breve} che ho visto sul vostro sito.\n\nGrazie!`);
---
<section class="opere sezione" id="opere" aria-labelledby="opere-titolo" data-opere>
  <div class="opere__faretto" aria-hidden="true" data-faretto></div>

  <header class="sezione__testa" data-svela>
    <p class="etichetta opere__eti">Quadri d'autore · Pop art · Classico moderno</p>
    <h2 id="opere-titolo" class="sezione__titolo">Le opere</h2>
    <p class="sezione__intro">
      Alcuni dei pezzi appesi in galleria adesso. Passa la luce sulla parete:
      dove arriva, tornano i colori. Per ogni opera puoi chiederci tutto, dal vivo o per email.
    </p>
  </header>

  <div class="bento">
    <figure class="opera opera--evidenza" data-opera data-svela>
      <div class="cornice">
        <Picture src={evidenza.img} alt={evidenza.alt} formats={['avif', 'webp']}
          widths={[420, 640, 900, 1200]} sizes="(max-width: 860px) 84vw, 38vw" loading="lazy" decoding="async" />
      </div>
      <figcaption class="opera__dida">
        <p class="etichetta">In evidenza</p>
        <p class="opera__testo">Questa stampa è in negozio adesso. Ti diciamo noi tutto quello che c'è da sapere: chiedici pure.</p>
        <a class="btn btn--vuoto btn--piccolo" href={chiedi(evidenza.breve)}>Chiedici di quest'opera</a>
      </figcaption>
    </figure>

    {opere.map((o, i) => (
      <figure class={`opera ${i % 2 ? 'opera--sfalsata' : ''}`} data-opera data-svela>
        <div class="cornice">
          <Picture src={o.img} alt={o.alt} formats={['avif', 'webp']}
            widths={[320, 480, 720, 960]} sizes="(max-width: 860px) 84vw, 34vw" loading="lazy" decoding="async" />
        </div>
        <figcaption>
          <a class="opera__chiedi" href={chiedi(o.breve)}>Chiedi di quest'opera <span aria-hidden="true">→</span></a>
        </figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .opere {
    background:
      radial-gradient(80% 40% at 50% 0%, #26272c, transparent 70%),
      var(--sala);
    overflow: hidden;
  }
  .opere__eti { color: var(--salvia); }

  /* Il faretto: un velo scuro con un foro di luce che segue il cursore o il dito */
  .opere__faretto {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(circle at var(--fx, 50%) var(--fy, 30%),
      rgba(255, 228, 190, 0.10) 0, rgba(255, 228, 190, 0.04) 14rem, rgba(8, 8, 10, 0.55) 30rem);
    opacity: 0; transition: opacity var(--dur-lenta) var(--ease-out);
  }
  .opere.acceso .opere__faretto { opacity: 1; }

  .bento {
    position: relative; z-index: 1;
    max-width: 78rem; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr;
    column-gap: clamp(1.5rem, 6vw, 6rem); row-gap: clamp(3rem, 7vw, 6rem);
  }
  .opera { margin: 0; display: grid; gap: 1rem; justify-items: center; }
  .opera--sfalsata { transform: translateY(clamp(2rem, 8vw, 7rem)); }
  .js .opera--sfalsata[data-svela] { transform: translateY(calc(clamp(2rem, 8vw, 7rem) + 28px)); }
  .js .opera--sfalsata[data-svela].svelato { transform: translateY(clamp(2rem, 8vw, 7rem)); }

  .opera--evidenza {
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center; gap: clamp(2rem, 6vw, 6rem);
    padding-bottom: clamp(1rem, 4vw, 3rem);
  }

  /* Cornice: listello scuro + passepartout avorio, come le opere in galleria */
  .cornice {
    width: min(100%, 30rem);
    padding: clamp(0.6rem, 1.6vw, 1.1rem);
    background: var(--avorio);
    border: clamp(6px, 0.8vw, 10px) solid #0e0e10;
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.12),
      0 1px 0 1px rgba(255, 255, 255, 0.06),
      0 30px 60px -20px rgba(0, 0, 0, 0.8);
    transition: transform var(--dur-media) var(--ease-out);
  }
  .opera--evidenza .cornice { width: 100%; max-width: 36rem; justify-self: end; }
  .cornice :global(img) {
    width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
    filter: grayscale(1) contrast(1.06);
    transition: filter var(--dur-lenta) var(--ease-out);
  }
  .opera:hover .cornice :global(img),
  .opera:focus-within .cornice :global(img),
  .opera.a-colori .cornice :global(img) { filter: none; }
  .opera:hover .cornice { transform: scale(1.02); }

  .opera__dida { display: grid; gap: 1rem; justify-items: start; max-width: 28rem; }
  .opera__dida .etichetta { color: var(--salvia); }
  .opera__testo { font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem); font-weight: 300; line-height: 1.35; }

  .opera__chiedi {
    display: inline-flex; gap: 0.5em; align-items: center; min-height: 2.75rem;
    font-size: var(--fs-etichetta); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    text-decoration: none; color: var(--nebbia);
    transition: color var(--dur-rapida) var(--ease-out);
  }
  .opera__chiedi span { transition: transform var(--dur-rapida) var(--ease-out); }
  .opera__chiedi:hover, .opera__chiedi:focus-visible { color: var(--avorio); }
  .opera__chiedi:hover span { transform: translateX(4px); }

  @media (max-width: 860px) {
    .bento { grid-template-columns: 1fr; }
    .opera--sfalsata, .js .opera--sfalsata[data-svela].svelato { transform: none; }
    .js .opera--sfalsata[data-svela] { transform: translateY(28px); }
    .opera--evidenza { grid-template-columns: 1fr; }
    .opera--evidenza .cornice { justify-self: center; }
    .cornice { width: min(100%, 26rem); }
  }
</style>

<script>
  import { riduci } from '../scripts/movimento';
  const sez = document.querySelector<HTMLElement>('[data-opere]');
  const faretto = sez?.querySelector<HTMLElement>('[data-faretto]');
  if (sez && faretto) {
    const opere = [...sez.querySelectorAll<HTMLElement>('[data-opera]')];
    const fine = window.matchMedia('(pointer: fine)').matches;

    // Su touch (o senza hover) l'opera torna a colori quando è ben visibile
    if (!fine || riduci()) {
      const io = new IntersectionObserver((v) => v.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('a-colori'); io.unobserve(e.target); }
      }), { threshold: 0.6 });
      opere.forEach((o) => io.observe(o));
    }

    if (!riduci()) {
      let raf = 0, x = 50, y = 30;
      const muovi = (cx: number, cy: number) => {
        const r = sez.getBoundingClientRect();
        x = cx - r.left; y = cy - r.top;
        if (!raf) raf = requestAnimationFrame(() => {
          faretto.style.setProperty('--fx', `${x}px`);
          faretto.style.setProperty('--fy', `${y}px`);
          raf = 0;
        });
      };
      sez.addEventListener('pointermove', (e) => { sez.classList.add('acceso'); muovi(e.clientX, e.clientY); });
      sez.addEventListener('pointerleave', () => sez.classList.remove('acceso'));
      // Touch: il faretto segue il dito anche mentre scorri
      sez.addEventListener('touchstart', (e) => { sez.classList.add('acceso'); muovi(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
      sez.addEventListener('touchmove', (e) => muovi(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    }
  }
</script>
