---
import { negozio } from '../data/sito';
const link = [
  { href: '/#chi-sono', label: 'Chi sono' },
  { href: '/#collezione', label: 'Collezione' },
  { href: '/#spazio', label: 'Lo spazio' },
  { href: '/#visita', label: 'Visita' },
];
---
<header class="nav" data-nav>
  <a class="nav__logo" href="/">
    <span class="nav__logo-b">Benny</span> <span class="nav__logo-s">Store</span><span class="sr-only">, pagina iniziale</span>
  </a>

  <nav class="nav__link" aria-label="Principale">
    <ul>
      {link.map((l, i) => <li><a class="sottolinea" href={l.href}><span class="nav__n" aria-hidden="true">0{i + 1}</span>{l.label}</a></li>)}
    </ul>
  </nav>

  <a class="nav__cta" href={negozio.telefono.href}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="15" height="15"><path fill="currentColor" d="M6.6 10.8a15.2 15.2 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
    <span>Chiamaci</span>
  </a>

  <button class="nav__menu" type="button" aria-expanded="false" aria-controls="menu-mobile" data-menu-btn>
    <span class="nav__menu-icona" aria-hidden="true"></span>
    <span class="sr-only">Menu</span>
  </button>
</header>

<div class="menu" id="menu-mobile" hidden data-menu>
  <nav aria-label="Menu mobile">
    <ul>
      {link.map((l, i) => <li><a href={l.href}><span class="etichetta">0{i + 1}</span>{l.label}</a></li>)}
    </ul>
  </nav>
  <div class="menu__contatti">
    <a class="btn" href={negozio.telefono.href}>Chiamaci · {negozio.telefono.vista}</a>
    <a class="btn btn--vuoto" href={`mailto:${negozio.email}`}>Scrivici</a>
  </div>
</div>

<style>
  .nav {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    height: var(--nav-h);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 var(--gutter);
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .nav > * { pointer-events: auto; }

  .nav__logo {
    justify-self: start;
    display: inline-flex; align-items: baseline; gap: 0.25em;
    padding: 0.75rem 0;
    text-decoration: none; line-height: 1;
  }
  .nav__logo-b { font-weight: 800; font-size: 1rem; letter-spacing: -0.01em; text-transform: uppercase; }
  .nav__logo-s { font-family: var(--serif); font-style: italic; font-size: 1.375rem; }

  .nav__link ul { display: flex; gap: clamp(1.5rem, 3vw, 3rem); list-style: none; margin: 0; padding: 0; }
  .nav__link a {
    display: inline-flex; align-items: baseline; gap: 0.5em; padding: 0.75rem 0;
    font-size: var(--fs-etichetta); font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
  }
  .nav__link a::after { bottom: 0.5rem; }
  .nav__n { font-family: var(--serif); font-style: italic; font-size: 0.95rem; letter-spacing: 0; text-transform: none; opacity: 0.7; }

  .nav__cta {
    justify-self: end;
    display: inline-flex; align-items: center; gap: 0.55rem;
    min-height: 2.75rem; padding: 0 1.2rem;
    border: 1px solid currentColor; border-radius: 999px;
    font-size: var(--fs-etichetta); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--dur-rapida) var(--ease-out), background-color var(--dur-rapida) var(--ease-out), color var(--dur-rapida) var(--ease-out);
  }
  .nav__cta:hover { transform: scale(1.02); background: #fff; color: #000; }
  .nav__cta:active { transform: scale(0.98); }

  .nav__menu { display: none; }

  @media (max-width: 860px) {
    .nav { grid-template-columns: 1fr auto auto; gap: 0.5rem; }
    .nav__link { display: none; }
    .nav__cta span {
      position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap;
    }
    .nav__cta { width: 2.75rem; justify-content: center; padding: 0; }
    .nav__menu {
      display: grid; place-items: center;
      width: 2.75rem; height: 2.75rem; padding: 0;
      background: none; border: 1px solid currentColor; border-radius: 999px; cursor: pointer;
    }
    .nav__menu-icona, .nav__menu-icona::before {
      display: block; width: 16px; height: 1.5px; background: currentColor;
      transition: transform var(--dur-rapida) var(--ease-out);
    }
    .nav__menu-icona { position: relative; transform: translateY(-3px); }
    .nav__menu-icona::before { content: ''; position: absolute; top: 6px; }
    .nav__menu[aria-expanded='true'] .nav__menu-icona { transform: rotate(45deg); }
    .nav__menu[aria-expanded='true'] .nav__menu-icona::before { transform: translateY(-6px) rotate(-90deg); }
  }

  .menu {
    position: fixed; inset: 0; z-index: 40;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: calc(var(--nav-h) + 2rem) var(--gutter) 2rem;
    background: var(--carta); color: var(--inchiostro);
  }
  .menu[hidden] { display: none; }
  /* Telefono in orizzontale: voci più piccole e, se serve, il menu scorre */
  .menu { overflow-y: auto; overscroll-behavior: contain; }
  .menu ul { list-style: none; margin: 0; padding: 0; }
  .menu li { border-bottom: 1px solid var(--linea); }
  .menu li a {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding: 0.9rem 0;
    font-family: var(--serif); font-style: italic; font-size: clamp(2.5rem, 12vw, 4rem); line-height: 1;
    text-decoration: none;
  }
  .menu li a .etichetta { font-family: var(--font); font-style: normal; color: var(--grafite); }
  .menu__contatti { display: grid; gap: 0.75rem; }
  @media (orientation: landscape) and (max-height: 520px) {
    .menu { justify-content: flex-start; gap: 1.5rem; padding-top: calc(var(--nav-h) + 0.5rem); }
    .menu li a { font-size: 2rem; padding: 0.5rem 0; }
    .menu__contatti { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (btn && menu) {
    const chiudi = (focus = true) => {
      btn.setAttribute('aria-expanded', 'false');
      menu.hidden = true;
      document.documentElement.classList.remove('menu-aperto');
      if (focus) btn.focus();
    };
    btn.addEventListener('click', () => {
      const aperto = btn.getAttribute('aria-expanded') === 'true';
      if (aperto) return chiudi();
      btn.setAttribute('aria-expanded', 'true');
      menu.hidden = false;
      document.documentElement.classList.add('menu-aperto');
      menu.querySelector('a')?.focus();
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) chiudi(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) chiudi();
    });
  }
</script>
