---
import { negozio, mapsHref, natale } from '../data/sito';
import Neve from './Neve.astro';
const anno = new Date().getFullYear();
const manca = 'da confermare';
---
<footer class="piede-sito">
  {natale && <Neve quanti={70} strato="fondo" />}
  <div class="piede-sito__cta">
    {natale
      ? <p class="piede-sito__domanda">Il regalo di Natale <em>che resta appeso.</em></p>
      : <p class="piede-sito__domanda">Hai visto un'opera <em>che ti piace?</em></p>}
    <div class="piede-sito__bottoni">
      <a class="btn btn--chiaro" href={negozio.telefono.href}>Chiamaci · {negozio.telefono.vista}</a>
      <a class="btn btn--chiaro btn--vuoto" href={`mailto:${negozio.email}`}>Scrivici</a>
    </div>
  </div>

  <p class="piede-sito__nome" aria-hidden="true"><span>Benny</span> <em>Store</em></p>

  <div class="piede-sito__griglia">
    <div>
      <h2 class="etichetta">Galleria</h2>
      <address>
        <a class="link" href={mapsHref} target="_blank" rel="noopener">{negozio.indirizzo.via}<br />{negozio.indirizzo.citta} ({negozio.indirizzo.provincia})<span class="sr-only"> (apre Google Maps in una nuova scheda)</span></a>
      </address>
    </div>
    <div>
      <h2 class="etichetta">Contatti</h2>
      <p><a class="link" href={negozio.telefono.href}>{negozio.telefono.vista}</a><br />
        <a class="link" href={`mailto:${negozio.email}`}>{negozio.email}</a></p>
    </div>
    <div>
      <h2 class="etichetta">Dati societari</h2>
      <p class="piede-sito__dati">
        {negozio.ragioneSociale ?? <span class="da-confermare">Ragione sociale: {manca}</span>}<br />
        P.IVA {negozio.piva}<br />
        C.F. {negozio.codiceFiscale ?? <span class="da-confermare">{manca}</span>} · REA {negozio.rea ?? <span class="da-confermare">{manca}</span>}<br />
        PEC {negozio.pec ?? <span class="da-confermare">{manca}</span>}
      </p>
    </div>
    <div>
      <h2 class="etichetta">Informazioni</h2>
      <ul>
        <li><a class="link" href="/privacy">Privacy</a></li>
        <li><a class="link" href="/privacy#cookie">Cookie</a></li>
        <li><button type="button" class="link piede-sito__pref" data-apri-preferenze>Preferenze cookie</button></li>
        <li><a class="link" href="/termini">Note legali</a></li>
        <li><a class="link" href="/accessibilita">Accessibilità</a></li>
      </ul>
    </div>
  </div>
  <p class="piede-sito__firma">© {anno} {negozio.nome} · {negozio.qualifica}</p>
</footer>

<style>
  .piede-sito {
    position: relative; overflow: hidden;
    padding: clamp(4rem, 10vw, 8rem) var(--gutter) 2rem;
    background: var(--sala); color: var(--avorio);
  }
  .piede-sito :focus-visible { outline-color: var(--indaco-luce); }
  .piede-sito > :not(canvas) { position: relative; z-index: 2; }
  .piede-sito__cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 2rem; max-width: var(--max); margin: 0 auto; }
  .piede-sito__domanda { font-family: var(--serif); font-size: clamp(2.25rem, 1.4rem + 3.5vw, 4.75rem); line-height: 1; max-width: 14ch; }
  .piede-sito__domanda em { color: var(--nebbia); }
  .piede-sito__bottoni { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .piede-sito__nome {
    margin: clamp(3rem, 8vw, 6rem) 0 clamp(2rem, 6vw, 4rem);
    display: flex; justify-content: space-between; gap: 0.1em;
    font-family: var(--serif); font-size: clamp(5rem, 21.5vw, 30rem); line-height: 0.78; letter-spacing: -0.04em;
    color: transparent; -webkit-text-stroke: 1px rgba(244, 242, 236, 0.4);
    user-select: none; white-space: nowrap;
  }
  .piede-sito__nome em { color: var(--avorio); -webkit-text-stroke: 0; }
  .piede-sito__griglia {
    max-width: var(--max); margin: 0 auto;
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem;
    padding-top: 2rem; border-top: 1px solid rgba(244, 242, 236, 0.16);
    font-size: 0.9375rem; line-height: 1.7;
  }
  .piede-sito__griglia h2 { color: var(--nebbia); margin-bottom: 0.6rem; }
  .piede-sito__griglia address { font-style: normal; }
  .piede-sito__griglia ul { list-style: none; margin: 0; padding: 0; }
  .piede-sito__pref { background: none; border: 0; padding: 0; cursor: pointer; font-size: inherit; }
  .piede-sito__dati .da-confermare { font-size: 0.8125rem; }
  .piede-sito__firma { max-width: var(--max); margin: 3rem auto 0; color: var(--nebbia); font-size: 0.8125rem; }
  @media (max-width: 860px) {
    .piede-sito__griglia { grid-template-columns: 1fr 1fr; }
    .piede-sito__nome { flex-direction: column; font-size: 34vw; }
    .piede-sito__nome em { align-self: flex-end; }
  }
  @media (max-width: 480px) { .piede-sito__griglia { grid-template-columns: 1fr; } }
</style>
